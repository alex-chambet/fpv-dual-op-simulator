[ext_resource type="Script" path="res://scenarios/subjects/subject_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ski_freeride"
display_name = "Ski freeride"
category = "Neige / glace"
description = "Freeride façon Freeride World Tour : une grande face raide de poudreuse sous une arête, des barres rocheuses à sauter (falaises de 7 à 13 m) ou à passer par un couloir, de grandes courbes rapides, du tout-droit qui accélère, des virages serrés, des contrôles de vitesse en dérapage (skis en travers), des réceptions qui cassent la vitesse. Le sujet le plus dur à filmer. Environ 1 min 30."
archetype = "FREERIDE"
overrides = {}
subject_size = 1.8
placeholder_shape = "person"
placeholder_gear = "skis"
placeholder_color = Color(0.04, 0.5, 0.48, 1)
placeholder_accent = Color(0.98, 0.55, 0.08, 1)
environment = "freeride"
env_overrides = {}
recommended_movements = PackedStringArray("pursuit", "lateral", "frontal", "orbit", "reveal", "flyby", "approach_orbit", "dive", "choreo")
base_difficulty = 5
