[ext_resource type="Script" path="res://scenarios/subjects/subject_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ski_descente"
display_name = "Ski de descente"
category = "Neige / glace"
description = "Descente de ski façon Streif ou Bellevarde : un mur de départ à 70 %, de grands murs à 65-80 %, des glisses, des cassures de pente qui envoient en l'air, de grandes courbes à 100-250 m de rayon et quelques virages serrés à 40-60 m (souvent en S), une porte à chaque virage, schuss à plus de 130 km/h. Entre 1 min 30 et 1 min 45."
archetype = "DESCENTE"
overrides = {
"cornering_accel": 20.0,
"duration": 98.0,
"lean_gain": 0.9,
"lean_max_deg": 55.0,
"speed_max": 38.0,
"speed_min": 14.0,
"tight_turns": 0.35,
"turn_frequency": 0.6,
"turn_tightness": 0.4
}
subject_size = 1.8
placeholder_shape = "person"
placeholder_gear = "skis"
placeholder_color = Color(0.85, 0.08, 0.1, 1)
placeholder_accent = Color(0.95, 0.95, 0.95, 1)
environment = "descente"
env_overrides = {
"relief": 0.7
}
recommended_movements = PackedStringArray("pursuit", "lateral", "frontal", "orbit", "reveal", "flyby", "approach_orbit", "dive", "choreo")
base_difficulty = 4
