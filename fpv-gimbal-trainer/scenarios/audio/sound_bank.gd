class_name SoundBank
extends RefCounted
## The sounds of the simulator, generated by code - like everything else here, there is not a
## single audio file in the project.
##
## Each one is a short seamless loop, built once and kept. Nothing is played at its own pitch: the
## voices (SubjectVoice, DroneVoice) stretch these loops with `pitch_scale` and fade them against
## each other, so the sound follows the speed of the subject exactly rather than approximately.
## That matters here more than it would in another game - the whole design rests on the operator
## being able to ANTICIPATE, and hearing an engine come up to the braking zone is a second channel
## for that, next to the body of the skier or the attitude of the car.
##
## Everything is mono: the listener is the gimbal camera, so the subject is a point in space that
## the drone is flying around, and that is exactly what a mono 3D source gives.

const RATE := 22050          ## plenty for engine noise and wind; half the samples to generate
const SEAM := 512            ## frames crossfaded across the loop point, so it does not click

## Reference pitches, so a voice knows what `pitch_scale` means.
const ENGINE_HZ := 50.0      ## firing frequency the engine loop is built at
const PROP_HZ := 110.0       ## blade-pass frequency the drone loop is built at

static var _cache := {}


## A four-stroke engine: a sharp combustion pulse per firing event, its harmonics, and the rasp of
## the intake. `roughness` separates a racing V8 (low, hard pulses) from a small road engine.
static func engine(roughness := 0.5) -> AudioStreamWAV:
	return _make("engine%.2f" % roughness, func() -> PackedFloat32Array:
		var period := int(RATE / ENGINE_HZ)          # whole periods, so the loop stays periodic
		var n := period * int(ENGINE_HZ)             # exactly one second
		var out := PackedFloat32Array()
		out.resize(n)
		var rng := RandomNumberGenerator.new()
		rng.seed = 12345
		var rasp := 0.0
		for i in n:
			# two firing events per period, slightly uneven: a perfectly even engine buzzes
			var u := fposmod(float(i) / period, 0.5) * 2.0
			var second: bool = fmod(float(i) / period, 1.0) >= 0.5
			var gain := 1.0 if not second else lerpf(1.0, 0.72, roughness)
			var env := exp(-u * lerpf(11.0, 6.0, roughness))
			var tone := sin(TAU * u) * 0.6 + sin(TAU * 2.0 * u) * 0.3 + sin(TAU * 3.0 * u) * 0.14
			rasp = lerpf(rasp, rng.randf_range(-1.0, 1.0), 0.45)   # one-pole low pass on noise
			out[i] = gain * (env * tone * 0.8 + env * env * rasp * lerpf(0.25, 0.5, roughness))
		return out)


## Tyres and suspension on the road: low, broad, no pitch of its own.
static func rolling() -> AudioStreamWAV:
	return _make("rolling", func() -> PackedFloat32Array:
		return _noise(RATE, 0.10, 0.0, 777))


## Skis or a board on snow. Bright and airy when the edges are carving, much louder and broader
## when they are skidding - the voice crossfades between the two by moving the filter.
static func edges() -> AudioStreamWAV:
	return _make("edges", func() -> PackedFloat32Array:
		return _noise(RATE, 0.55, 0.22, 4242))


## The drone itself: the blade-pass tone of four props, never quite in phase, over broadband flow.
static func prop() -> AudioStreamWAV:
	return _make("prop", func() -> PackedFloat32Array:
		var n := RATE   # exactly one second, so a whole-Hz rotor completes whole cycles
		var out := PackedFloat32Array()
		out.resize(n)
		var rng := RandomNumberGenerator.new()
		rng.seed = 909
		var air := 0.0
		# Four rotors, none quite at the same speed: that slow beating is what makes four props
		# sound like one quad rather than like a siren. The frequencies are WHOLE numbers of cycles
		# per loop, so every one of them is continuous across the seam - detune them by a fraction
		# and the loop thumps once a second instead.
		var rotors := [110.0, 111.0, 109.0, 112.0]
		for i in n:
			var t := float(i) / RATE
			var v := 0.0
			for f in rotors:
				var ph := TAU * float(f) * t
				v += sin(ph) * 0.5 + sin(ph * 2.0) * 0.22 + sin(ph * 3.0) * 0.08
			air = lerpf(air, rng.randf_range(-1.0, 1.0), 0.6)
			out[i] = v * 0.17 + air * 0.3
		return out)


## Air over the airframe: all broadband, no pitch. The voice gives it the level, not the colour.
static func wind() -> AudioStreamWAV:
	return _make("wind", func() -> PackedFloat32Array:
		return _noise(RATE, 0.16, 0.0, 31337))


# --- Building blocks ---------------------------------------------------------------------------

## One second of noise, low-passed at `lp` (0..1, one-pole) and optionally high-passed at `hp` to
## open it up. Bright noise alone hisses; taking the bottom out of it is what makes it an edge on
## snow rather than static.
static func _noise(n: int, lp: float, hp: float, seed_value: int) -> PackedFloat32Array:
	var out := PackedFloat32Array()
	out.resize(n)
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value
	var low := 0.0
	var base := 0.0
	for i in n:
		low = lerpf(low, rng.randf_range(-1.0, 1.0), lp)
		var v := low
		if hp > 0.0:
			base = lerpf(base, low, hp)
			v = low - base
		out[i] = v
	return out


## Builds the stream once and keeps it: five loops of a second each cost about a tenth of a second
## of GDScript, and nothing after the first level pays it again.
static func _make(key: String, build: Callable) -> AudioStreamWAV:
	if _cache.has(key):
		return _cache[key]
	var s: PackedFloat32Array = build.call()
	_centre(s)
	_seam(s)
	var w := AudioStreamWAV.new()
	w.format = AudioStreamWAV.FORMAT_16_BITS
	w.mix_rate = RATE
	w.stereo = false
	w.data = _pack(s)
	w.loop_mode = AudioStreamWAV.LOOP_FORWARD
	w.loop_begin = 0
	w.loop_end = s.size()
	_cache[key] = w
	return w


## Takes the mean out. A combustion pulse is one-sided, so the raw engine signal sits well off
## zero: that offset is inaudible by itself but it eats headroom and thumps when the voice fades
## the player in and out.
static func _centre(s: PackedFloat32Array) -> void:
	var mean := 0.0
	for v in s:
		mean += v
	mean /= maxf(s.size(), 1)
	for i in s.size():
		s[i] -= mean


## Crossfades the tail of the loop onto its head, so the seam cannot click.
static func _seam(s: PackedFloat32Array) -> void:
	var n := s.size()
	var f := mini(SEAM, n / 4)
	for k in f:
		var a := float(k) / f
		s[k] = lerpf(s[n - f + k], s[k], a)


static func _pack(s: PackedFloat32Array) -> PackedByteArray:
	var peak := 0.0001
	for v in s:
		peak = maxf(peak, absf(v))
	var gain := 0.92 / peak            # normalised, with a little headroom
	var b := PackedByteArray()
	b.resize(s.size() * 2)
	for i in s.size():
		var q := clampi(roundi(s[i] * gain * 32767.0), -32768, 32767)
		b.encode_s16(i * 2, q)
	return b
